{
  "name": "screenshot-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "app": "node scripts/run.mjs",
    "app:check": "node scripts/run.mjs --check",
    "dev": "node scripts/ensure-port.mjs && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "cargo test --workspace --locked",
    "verify": "npm test && npm run build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
