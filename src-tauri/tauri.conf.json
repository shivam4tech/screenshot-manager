{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshot Memory",
  "version": "1.0.0",
  "identifier": "app.screenshotmemory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screenshot Memory",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.local/share/screenshot-memory/**",
          "$HOME/Library/Application Support/screenshot-memory/**",
          "$HOME/AppData/Local/screenshot-memory/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Searchable visual memory for your screenshots",
    "longDescription": "Screenshot Memory turns your existing screenshot collection into a searchable personal visual memory. Local-first and offline: full-text search over filenames and OCR text, tags, collections, timeline, and duplicate review — without moving, renaming, or modifying a single file."
  }
}
